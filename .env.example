# SalviaChat / Ollama
SALVIACHAT_OLLAMA_BASE_URL=http://127.0.0.1:11434
SALVIACHAT_MODEL=qwen2.5-coder:7b
SALVIACHAT_SQL_MODEL=qwen2.5-coder:7b
SALVIACHAT_ROUTER_MODEL=qwen2.5-coder:7b
SALVIACHAT_EVALUATOR_MODEL=qwen2.5-coder:7b
SALVIACHAT_GENERATOR_MODEL=qwen2.5:14b
SALVIACHAT_TOOL_MODEL=qwen2.5-coder:7b
SALVIACHAT_FAST_MODE=true
SALVIACHAT_WARM_MODELS=true
SALVIACHAT_KEEP_ALIVE=24h
SALVIACHAT_NUM_CTX=16000

# MySQL: never commit real credentials
SALVIACHAT_DB_HOST=127.0.0.1
SALVIACHAT_DB_PORT=3306
SALVIACHAT_DB_USER=salviachat
SALVIACHAT_DB_PASSWORD=CHANGE_ME
SALVIACHAT_DB_NAME=salvia

# ProMoAI local Hugging Face model directory
PROMOAI_MODEL_PATH=/absolute/path/to/promoai-best-model

# DeepPPI worker
DEEPPPI_WORKER_URL=http://127.0.0.1:8001/predict_ppi
DEEPPPI_DEVICE=auto

# Metabolome worker and external data
METABOLOME_WORKER_URL=http://127.0.0.1:8002/predict_multi_gene
METABOLOME_HEALTH_URL=http://127.0.0.1:8002/health
METABOLOME_WORKER_TIMEOUT=600
METABOLOME_DATA_DIR=/absolute/path/to/pred_gene
METABOLOME_ANNOTATION_PATH=/absolute/path/to/dss_final_annotation.csv

# Optional local scientific assets
SALVIACHAT_HOMOLOGY_CSV=/absolute/path/to/Homology.csv
SALVIACHAT_BLAST_PROTEIN_DB=/absolute/path/to/salvia_all_protein
SALVIACHAT_BLAST_CDS_DB=/absolute/path/to/salvia_all_cds
SALVIACHAT_PFAM_DB=/absolute/path/to/Pfam-A.hmm
SALVIACHAT_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
SALVIACHAT_VECTOR_DB=/absolute/path/to/salvia_abstract_vectordb

# Optional tracing; leave disabled for a public deployment
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=DeepSalviaDB
LANGCHAIN_API_KEY=
